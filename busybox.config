# Busybox minimal config for miniOS (mlibc/static)
# Generated for Busybox 1.37.0

CONFIG_STATIC=y
CONFIG_CROSS_COMPILER_PREFIX="x86_64-elf-"

# Applets
CONFIG_CAT=y
CONFIG_CLEAR=y
CONFIG_DF=y
CONFIG_ECHO=y
CONFIG_FREE=y
CONFIG_MKDIR=y
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_STAT=y
CONFIG_LSPCI=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=n
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=256
CONFIG_FEATURE_EDITING_SAVEHISTORY=n
CONFIG_FEATURE_TAB_COMPLETION=n
CONFIG_FEATURE_USERNAME_COMPLETION=n
CONFIG_FEATURE_EDITING_FANCY_PROMPT=n
CONFIG_FEATURE_EDITING_ASK_TERMINAL=n
CONFIG_KILL=y
CONFIG_KILLALL=n
CONFIG_LS=y
CONFIG_FEATURE_LS_COLOR=n
CONFIG_SLEEP=y

# /proc/<pid> is now populated (status/stat/cmdline/cwd/maps) — enable the
# applets that read it. Keep CONFIG_FEATURE_FAST_TOP off (default): our
# /proc/<pid>/stat generator matches the plain sscanf parser in
# libbb/procps.c, not the fast_strtoul_10 field-skip-count path.
CONFIG_PS=y
CONFIG_PSTREE=y
# CONFIG_TOP: the VM-crashing bug is fixed (see the SYS_execve teardown-
# before-load-succeeds fix in syscall_proc.c) — top now fails safely
# (exits 1) instead of taking the whole system down with it. It doesn't
# fully render a process table yet (root cause of that not chased further),
# but that's an ordinary applet limitation, not a system-safety issue.
CONFIG_TOP=y
# Without this, top never calls set_termios_to_raw() and its whole
# keyboard-command loop is compiled out — it just free-runs, redrawing
# every 5s, and only a real SIGINT (^C) stops it. Busybox's own Config.in
# says so verbatim. This project's config is built from an allnoconfig
# base, so upstream's "default y" for this symbol doesn't apply — it has
# to be listed explicitly like everything else here.
CONFIG_FEATURE_TOP_INTERACTIVE=y

# mount(2) is fully wired (vfs_mount_fstype dispatch); umount(2) is a no-op
# stub (accepts and returns 0 but doesn't touch the mount table) — mount
# works, umount silently does nothing.
CONFIG_MOUNT=y
CONFIG_MOUNTPOINT=y

# Disable things that require glibc / kernel features not in miniOS
CONFIG_FEATURE_SHADOWPASSWDS=n
CONFIG_USE_BB_PWD_GRP=y
CONFIG_LOCALE_SUPPORT=n
CONFIG_UNICODE_SUPPORT=n
CONFIG_FEATURE_GETOPT_LONG=y

# Disable some networking applets
CONFIG_IFCONFIG=n
CONFIG_WGET=n
CONFIG_NETSTAT=n

# Disable applets requiring PAM/shadow/utmp
CONFIG_LOGIN=n
CONFIG_GETTY=n
CONFIG_SU=n
CONFIG_PASSWD=n

# Build settings
CONFIG_DEBUG=n

# Extra libraries appended by trylink after the busybox objects.
# miniOS provides the retargetable syscall layer; newlib provides the C library.
CONFIG_EXTRA_LDLIBS=""
